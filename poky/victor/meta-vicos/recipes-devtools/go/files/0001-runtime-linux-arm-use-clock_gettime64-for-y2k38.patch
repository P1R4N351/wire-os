From: P1R4N351 <P1R4N351@users.noreply.github.com>
Subject: [PATCH] runtime: use clock_gettime64 (#403) on linux/arm for Y2K38 safety
Upstream-Status: Backport [equivalent 64-bit time syscall behavior]

On 32-bit linux/arm, Go 1.25.9 runtime.walltime and runtime.nanotime1 invoke
32-bit SYS_clock_gettime (263) / __vdso_clock_gettime with a 12-byte stack
frame and hardcode sec_hi = 0. Across 2038-01-19T03:14:07Z this overflows.

Invoke SYS_clock_gettime64 (SYS_BASE + 403) with a 16-byte struct
__kernel_timespec and compute full 64-bit seconds and nanoseconds.

Signed-off-by: P1R4N351 <P1R4N351@users.noreply.github.com>
---
--- a/src/runtime/sys_linux_arm.s
+++ b/src/runtime/sys_linux_arm.s
@@ -41,6 +41,7 @@
 #define SYS_nanosleep (SYS_BASE + 162)
 #define SYS_sched_getaffinity (SYS_BASE + 242)
 #define SYS_clock_gettime (SYS_BASE + 263)
+#define SYS_clock_gettime64 (SYS_BASE + 403)
 #define SYS_timer_create (SYS_BASE + 257)
 #define SYS_timer_settime (SYS_BASE + 258)
 #define SYS_timer_delete (SYS_BASE + 261)
@@ -346,55 +347,48 @@
 	MOVW	R7, m_vdsoPC(R6)
 	RET
 
-TEXT runtime·walltime(SB),NOSPLIT,$12-12
+TEXT runtime·walltime(SB),NOSPLIT,$16-12
 	MOVW	$CLOCK_REALTIME, R0
-	MOVW	$spec-12(SP), R1	// timespec
+	MOVW	$spec-16(SP), R1	// __kernel_timespec
 
-	MOVW	runtime·vdsoClockgettimeSym(SB), R4
-	CMP	$0, R4
-	B.EQ	fallback
-
-	BL	runtime·vdsoCall(SB)
-
-	JMP	finish
-
-fallback:
-	MOVW	$SYS_clock_gettime, R7
+	MOVW	$0, R2
+	MOVW	R2, 0(R1)
+	MOVW	R2, 4(R1)
+	MOVW	R2, 8(R1)
+	MOVW	R2, 12(R1)
+	MOVW	$SYS_clock_gettime64, R7
 	SWI	$0
 
-finish:
-	MOVW	sec-12(SP), R0  // sec
-	MOVW	nsec-8(SP), R2  // nsec
+	MOVW	sec_lo-16(SP), R0	// sec_lo
+	MOVW	sec_hi-12(SP), R1	// sec_hi
+	MOVW	nsec-8(SP), R2		// nsec
 
 	MOVW	R0, sec_lo+0(FP)
-	MOVW	$0, R1
 	MOVW	R1, sec_hi+4(FP)
 	MOVW	R2, nsec+8(FP)
 	RET
 
 // func nanotime1() int64
-TEXT runtime·nanotime1(SB),NOSPLIT,$12-8
+TEXT runtime·nanotime1(SB),NOSPLIT,$16-8
 	MOVW	$CLOCK_MONOTONIC, R0
-	MOVW	$spec-12(SP), R1	// timespec
+	MOVW	$spec-16(SP), R1	// __kernel_timespec
 
-	MOVW	runtime·vdsoClockgettimeSym(SB), R4
-	CMP	$0, R4
-	B.EQ	fallback
-
-	BL	runtime·vdsoCall(SB)
-
-	JMP	finish
-
-fallback:
-	MOVW	$SYS_clock_gettime, R7
+	MOVW	$0, R2
+	MOVW	R2, 0(R1)
+	MOVW	R2, 4(R1)
+	MOVW	R2, 8(R1)
+	MOVW	R2, 12(R1)
+	MOVW	$SYS_clock_gettime64, R7
 	SWI	$0
 
-finish:
-	MOVW	sec-12(SP), R0  // sec
-	MOVW	nsec-8(SP), R2  // nsec
+	MOVW	sec_lo-16(SP), R0	// sec_lo
+	MOVW	sec_hi-12(SP), R5	// sec_hi
+	MOVW	nsec-8(SP), R2		// nsec
 
 	MOVW	$1000000000, R3
 	MULLU	R0, R3, (R1, R0)
+	MUL	R3, R5, R4
+	ADD	R4, R1
 	ADD.S	R2, R0
 	ADC	$0, R1	// Add carry bit to upper half.
 
